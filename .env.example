# Referencia: asignar estas variables en el entorno; no se carga automáticamente.
# Generar SECRET_KEY con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Una ruta relativa se resuelve desde la raíz del proyecto.
DATABASE_PATH=saladetareas.db
FLASK_DEBUG=0
# Usar 1 en producción con HTTPS; mantener 0 para desarrollo por HTTP.
SESSION_COOKIE_SECURE=0
